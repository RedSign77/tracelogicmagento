<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="WebtechSolutions_TraceLogic::tracelogic" title="TraceLogic Compliance" sortOrder="200">
                    <resource id="WebtechSolutions_TraceLogic::report" title="Compliance report" sortOrder="10"/>
                    <resource id="WebtechSolutions_TraceLogic::supplier" title="Supplier data requests" sortOrder="20"/>
                    <resource id="WebtechSolutions_TraceLogic::order_check" title="Verify / re-check orders" sortOrder="30"/>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="WebtechSolutions_TraceLogic::config" title="TraceLogic Compliance Configuration"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
